{
    "name": "kuskus-kusto-language-server",
    "displayName": "[Kuskus] Kusto Language Server",
    "description": "Language server for the Kusto query language",
    "version": "1.0.31",
    "publisher": "rosshamish",
    "license": "Apache-2.0",
    "homepage": "https://github.com/rosshamish/kuskus",
    "repository": {
        "type": "git",
        "url": "https://github.com/rosshamish/kuskus"
    },
    "bugs": {
        "url": "https://github.com/rosshamish/kuskus/issues"
    },
    "engines": {
        "vscode": "^1.33.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters"
    ],
    "keywords": [
        "kusto",
        "language",
        "kuskus",
        "query",
        "azure data explorer",
        "azure",
        "csl",
        "kql"
    ],
    "activationEvents": [
        "onLanguage:kusto"
    ],
    "main": "./client/out/extension",
    "contributes": {
        "languages": [
            {
                "id": "kusto",
                "aliases": [
                    "Kusto",
                    "kusto"
                ],
                "extensions": [
                    ".csl",
                    ".kusto",
                    ".kql"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "[Kuskus] Kusto",
            "properties": {
                "kuskusLanguageServer.diagnosticsEnabled": {
                    "scope": "resource",
                    "type": "boolean",
                    "default": false,
                    "description": "Whether diagnostics are enabled or not (red squiggly underlines, Problems tab)"
                },
                "kuskus.customTables": {
                    "scope": "resource",
                    "type": "array",
                    "default": [],
                    "description": "Custom table definitions for Azure Resource Graph or other Kusto-like environments",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "columns"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Table name"
                            },
                            "description": {
                                "type": "string",
                                "description": "Table description"
                            },
                            "columns": {
                                "type": "array",
                                "description": "Column definitions",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "name",
                                        "type"
                                    ],
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "description": "Column name"
                                        },
                                        "type": {
                                            "type": "string",
                                            "description": "Column type (string, int, long, real, bool, datetime, dynamic, etc.)"
                                        },
                                        "description": {
                                            "type": "string",
                                            "description": "Column description"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "kuskus.customProperties": {
                    "scope": "resource",
                    "type": "object",
                    "default": {},
                    "description": "Custom property completions for dynamic columns (e.g., 'resources.properties': ['provisioningState', 'enabled'])",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "kuskus.customFunctions": {
                    "scope": "resource",
                    "type": "array",
                    "default": [],
                    "description": "Custom function definitions",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "returnType"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Function name"
                            },
                            "description": {
                                "type": "string",
                                "description": "Function description"
                            },
                            "returnType": {
                                "type": "string",
                                "description": "Return type (string, int, bool, dynamic, etc.)"
                            }
                        }
                    }
                }
            }
        },
        "commands": [
            {
                "command": "kuskus.loadSymbols",
                "title": "[Kuskus] Load Symbols from Cluster"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
        "test": "sh ./scripts/e2e.sh"
    },
    "devDependencies": {
        "@types/mocha": "^5.2.0",
        "@types/node": "^8.0.0",
        "glob": "^7.2.0",
        "mocha": "^9.2.2",
        "tslint": "^5.16.0",
        "typescript": "^5.5.4"
    },
    "dependencies": {
        "@types/lodash": "^4.14.136",
        "azure-kusto-data": "^0.2.5",
        "clipboardy": "^2.1.0",
        "lodash": "^4.17.19",
        "open": "^6.4.0"
    }
}
